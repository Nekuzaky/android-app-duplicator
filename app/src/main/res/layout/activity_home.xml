<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_step"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_logo" />

        <TextView
            style="@style/ScreenTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/privacyButton"
            style="@style/IconButton"
            android:contentDescription="@string/privacy"
            android:src="@drawable/ic_shield" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_hero"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/on_brand"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_brand"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/hero_pill"
            android:textColor="@color/mint"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setupCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout style="@style/StepRow">
            <TextView style="@style/StepNumber" android:text="1" />
            <TextView style="@style/StepText" android:text="@string/setup_step_1" />
        </LinearLayout>

        <LinearLayout style="@style/StepRow">
            <TextView style="@style/StepNumber" android:text="2" />
            <TextView style="@style/StepText" android:text="@string/setup_step_2" />
        </LinearLayout>

        <LinearLayout style="@style/StepRow">
            <TextView style="@style/StepNumber" android:text="3" />
            <TextView style="@style/StepText" android:text="@string/setup_step_3" />
        </LinearLayout>

        <Button
            android:id="@+id/createButton"
            style="@style/PrimaryButton"
            android:layout_marginTop="6dp"
            android:text="@string/setup_create" />
    </LinearLayout>

    <TextView
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/gridCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:paddingStart="10dp"
        android:paddingTop="16dp"
        android:paddingEnd="10dp">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="4dp"
            android:layoutAnimation="@anim/layout_grid"
            android:listSelector="@android:color/transparent"
            android:numColumns="4"
            android:paddingBottom="16dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp" />

        <TextView
            android:id="@+id/emptyClones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/empty_clones"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <Button
        android:id="@+id/addButton"
        style="@style/PrimaryButton"
        android:layout_marginTop="14dp"
        android:text="@string/add_app" />

    <Button
        android:id="@+id/manageButton"
        style="@style/SecondaryButton"
        android:layout_marginTop="10dp"
        android:text="@string/manage_space" />
</LinearLayout>
